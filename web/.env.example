# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Tradr API dogfood (optional) — same value as Cursor Cloud Agent TRADR_API_KEY
# See web/docs/DOGFOOD-TRADR-API.md
# TRADR_DOGFOOD_API_KEY=trad_your_long_secret_here
# TRADR_DOGFOOD_USER_ID=
# TRADR_DOGFOOD_SCOPES=planet:read,lexicon:read,study:write,planet:share
# TRADR_DOGFOOD_PLAN=pro

# Vercel Configuration (Optional, for deployment)
# Get this from: https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token-here

# Stripe Configuration (Optional, currently not used)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
