VERCEL_TOKEN=your-vercel-token-here

# Stripe Configuration (Optional, currently not used)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
